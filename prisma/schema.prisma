generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Content {
  id                         BigInt        @id @default(autoincrement())
  title                      String        @db.VarChar(255)
  tags                       Json
  cover                      Json?
  content                    String        @db.LongText
  createdBy                  Int           @map("created_by")
  updatedBy                  Int           @map("updated_by")
  createdAt                  DateTime?     @map("created_at") @db.DateTime(0)
  updatedAt                  DateTime?     @map("updated_at") @db.DateTime(0)
  status                     ContentStatus @default(draft)
  deletedAt                  DateTime?     @map("deleted_at") @db.DateTime(0)
  reviewRemark               String?       @map("review_remark") @db.VarChar(255)
  userContentCreatedByTouser User          @relation("content_created_byTouser", fields: [createdBy], references: [id], onDelete: NoAction, map: "content_ibfk_1")
  userContentUpdatedByTouser User          @relation("content_updated_byTouser", fields: [updatedBy], references: [id], onDelete: NoAction, map: "content_ibfk_2")

  @@index([createdBy], map: "created_by")
  @@index([updatedBy], map: "updated_by")
  @@map("content")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Menu {
  id         BigInt     @id @default(autoincrement())
  parentId   BigInt     @default(0) @map("parent_id")
  name       String     @db.VarChar(255)
  type       MenuType
  icon       String?    @db.VarChar(255)
  path       String?    @db.VarChar(255)
  component  String?    @db.VarChar(255)
  permission String?    @db.VarChar(255)
  sort       BigInt
  createdAt  DateTime?  @map("created_at") @db.DateTime(0)
  updatedAt  DateTime?  @map("updated_at") @db.DateTime(0)
  deletedAt  DateTime?  @map("deleted_at") @db.DateTime(0)
  status     Int?       @default(0) @db.TinyInt
  roleMenu   RoleMenu[]

  @@unique([parentId, name], map: "uk_parent_name")
  @@map("menu")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Role {
  id          BigInt     @id @default(autoincrement())
  roleName    String     @unique(map: "uk_roleName") @db.VarChar(255)
  roleCode    String     @unique(map: "uk_roleCode") @db.VarChar(255)
  description String?    @db.VarChar(255)
  status      Int?       @default(0) @db.TinyInt
  createdAt   DateTime?  @db.DateTime(0)
  updatedAt   DateTime?  @db.DateTime(0)
  createdBy   BigInt?
  updatedBy   BigInt?
  deletedAt   DateTime?  @db.DateTime(0)
  roleMenu    RoleMenu[]
  user        User[]

  @@map("role")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model RoleMenu {
  id        BigInt    @id @default(autoincrement())
  roleId    BigInt    @map("role_id")
  menuId    BigInt    @map("menu_id")
  createdAt DateTime? @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "role_menu_ibfk_5")
  menu      Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade, map: "role_menu_ibfk_6")

  @@unique([roleId, menuId], map: "role_menu_menuId_roleId_unique")
  @@unique([roleId, menuId], map: "uk_role_menu")
  @@index([menuId], map: "menu_id")
  @@map("role_menu")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model SysDict {
  id          BigInt    @id @default(autoincrement())
  dictName    String    @map("dict_name") @db.VarChar(255)
  dictCode    String    @unique(map: "dict_code") @map("dict_code") @db.VarChar(255)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @db.DateTime(0)
  updatedAt   DateTime  @db.DateTime(0)
  deletedAt   DateTime? @db.DateTime(0)

  @@map("sys_dict")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model SysDictItem {
  id          BigInt    @id @default(autoincrement())
  itemText    String    @map("item_text") @db.VarChar(255)
  itemValue   String    @map("item_value") @db.VarChar(255)
  dictCode    String    @map("dict_code") @db.VarChar(255)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @db.DateTime(0)
  updatedAt   DateTime  @db.DateTime(0)
  deletedAt   DateTime? @db.DateTime(0)

  @@unique([itemValue, dictCode], map: "dict_code_item_value")
  @@map("sys_dict_item")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model User {
  id                            Int       @id @default(autoincrement())
  username                      String    @unique(map: "uk_username") @db.VarChar(255)
  password                      String    @default("123456") @db.VarChar(255)
  nickname                      String    @db.VarChar(255)
  lastLoginTime                 DateTime? @db.DateTime(0)
  createdAt                     DateTime? @db.DateTime(0)
  updatedAt                     DateTime? @db.DateTime(0)
  deletedAt                     DateTime? @db.DateTime(0)
  status                        Int       @default(0) @db.TinyInt
  roleId                        BigInt
  phone                         String    @unique(map: "phone") @db.VarChar(255)
  avatar                        String    @db.VarChar(500)
  contentContentCreatedByTouser Content[] @relation("content_created_byTouser")
  contentContentUpdatedByTouser Content[] @relation("content_updated_byTouser")
  role                          Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, map: "user_ibfk_1")

  @@index([roleId], map: "roleId")
  @@map("user")
}

enum ContentStatus {
  draft
  pending
  published
  offline

  @@map("content_status")
}

enum MenuType {
  type_1 @map("1")
  type_2 @map("2")

  @@map("menu_type")
}
