generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model content {
  id                            BigInt         @id @default(autoincrement())
  title                         String         @db.VarChar(255)
  tags                          Json
  cover                         Json?
  content                       String         @db.LongText
  created_by                    Int
  updated_by                    Int
  created_at                    DateTime?      @db.DateTime(0)
  updated_at                    DateTime?      @db.DateTime(0)
  status                        content_status @default(draft)
  deleted_at                    DateTime?      @db.DateTime(0)
  review_remark                 String?        @db.VarChar(255)
  user_content_created_byTouser user           @relation("content_created_byTouser", fields: [created_by], references: [id], onDelete: NoAction, map: "content_ibfk_1")
  user_content_updated_byTouser user           @relation("content_updated_byTouser", fields: [updated_by], references: [id], onDelete: NoAction, map: "content_ibfk_2")

  @@index([created_by], map: "created_by")
  @@index([updated_by], map: "updated_by")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model menu {
  id         BigInt      @id @default(autoincrement())
  parent_id  BigInt      @default(0)
  name       String      @db.VarChar(255)
  type       menu_type
  icon       String?     @db.VarChar(255)
  path       String?     @db.VarChar(255)
  component  String?     @db.VarChar(255)
  permission String?     @db.VarChar(255)
  sort       BigInt
  created_at DateTime?   @db.DateTime(0)
  updated_at DateTime?   @db.DateTime(0)
  deleted_at DateTime?   @db.DateTime(0)
  status     Int?        @default(0) @db.TinyInt
  role_menu  role_menu[]

  @@unique([parent_id, name], map: "uk_parent_name")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model role {
  id          BigInt      @id @default(autoincrement())
  roleName    String      @unique(map: "uk_roleName") @db.VarChar(255)
  roleCode    String      @unique(map: "uk_roleCode") @db.VarChar(255)
  description String?     @db.VarChar(255)
  status      Int?        @default(0) @db.TinyInt
  createdAt   DateTime?   @db.DateTime(0)
  updatedAt   DateTime?   @db.DateTime(0)
  createdBy   BigInt?
  updatedBy   BigInt?
  deletedAt   DateTime?   @db.DateTime(0)
  role_menu   role_menu[]
  user        user[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model role_menu {
  id         BigInt    @id @default(autoincrement())
  role_id    BigInt
  menu_id    BigInt
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  role       role      @relation(fields: [role_id], references: [id], onDelete: Cascade, map: "role_menu_ibfk_5")
  menu       menu      @relation(fields: [menu_id], references: [id], onDelete: Cascade, map: "role_menu_ibfk_6")

  @@unique([role_id, menu_id], map: "role_menu_menuId_roleId_unique")
  @@unique([role_id, menu_id], map: "uk_role_menu")
  @@index([menu_id], map: "menu_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sys_dict {
  id          BigInt    @id @default(autoincrement())
  dict_name   String    @db.VarChar(255)
  dict_code   String    @unique(map: "dict_code") @db.VarChar(255)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @db.DateTime(0)
  updatedAt   DateTime  @db.DateTime(0)
  deletedAt   DateTime? @db.DateTime(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sys_dict_item {
  id          BigInt    @id @default(autoincrement())
  item_text   String    @db.VarChar(255)
  item_value  String    @db.VarChar(255)
  dict_code   String    @db.VarChar(255)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @db.DateTime(0)
  updatedAt   DateTime  @db.DateTime(0)
  deletedAt   DateTime? @db.DateTime(0)

  @@unique([item_value, dict_code], map: "dict_code_item_value")
